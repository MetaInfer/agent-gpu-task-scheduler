{
  "mcpServers": {
    "submitter": {
      "command": "@@CLIENT_ENTRYPOINT@@",
      "args": [
        "--base-url",
        "@@MASTER_URL@@",
        "--username",
        "@@USERNAME@@",
        "--ca-file",
        "@@CA_FILE@@"
      ],
      "cwd": "@@CLIENT_WORKSPACE@@",
      "directTools": [
        "create_proposal",
        "reply",
        "confirm_revision",
        "get_reviews",
        "resume",
        "cancel",
        "get_proposal",
        "get_task",
        "cancel_task",
        "wait_for_task",
        "wait_for_events",
        "get_logs"
      ]
    }
  }
}
